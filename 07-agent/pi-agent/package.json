{
  "name": "pi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight Pi-based local Codex agent.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "parity": "node scripts/check-parity.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "verify": "node scripts/verify.mjs",
    "doctor": "node scripts/doctor.mjs",
    "e2e:agent": "node scripts/e2e-agent.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.3",
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@hono/node-server": "^1.13.8",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.18",
    "typebox": "^1.0.55",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "25.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
