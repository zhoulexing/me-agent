# Required: your local Codex/OpenAI-compatible service.
CODEX_BASE_URL=http://127.0.0.1:8080/v1
CODEX_API_KEY=replace-me

# Optional.
CODEX_MODEL=gpt-5.3-codex-spark
CODEX_PROVIDER_ID=local-codex

# Pi supports "openai-responses", "openai-codex-responses", and "openai-completions".
# Use "openai-responses" for most OpenAI-compatible local services.
CODEX_API=openai-responses

# Agent working directory. Defaults to the pi-agent directory.
# PI_AGENT_CWD=/Users/zhouyuexing/.openclaw/workspace/me-agent

# Comma-separated Pi tool allowlist. Leave unset for the defaults below.
# PI_AGENT_TOOLS=read,grep,find,ls,bash,edit,write
